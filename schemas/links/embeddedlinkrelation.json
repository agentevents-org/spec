{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-events.dev/0.1.0-draft/schema/links/embeddedlinkrelation",
  "properties": {
    "linkType": {
      "type": "string",
      "enum": [
        "RELATION"
      ]
    },
    "linkKind": {
      "description": "A free-form label for the relationship, e.g. TRIGGER, HANDOFF, GUARDRAIL.",
      "type": "string",
      "minLength": 1
    },
    "target": {
      "$ref": "../common/definitions#/$defs/eventReference"
    },
    "tags": {
      "$ref": "../common/definitions#/$defs/linkTags"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "linkType",
    "linkKind",
    "target"
  ]
}
