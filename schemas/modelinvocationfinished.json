{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-events.dev/0.1.0-draft/schema/modelinvocation-finished-event",
  "allOf": [
    {
      "$ref": "common/definitions#/$defs/event"
    }
  ],
  "properties": {
    "context": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "dev.agent-events.modelinvocation.finished.0.1.0-draft"
          ],
          "default": "dev.agent-events.modelinvocation.finished.0.1.0-draft"
        }
      }
    },
    "subject": {
      "properties": {
        "content": {
          "properties": {
            "modelName": {
              "type": "string",
              "minLength": 1
            },
            "modelProvider": {
              "type": "string"
            },
            "agentRun": {
              "$ref": "common/definitions#/$defs/subjectReference"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "outcome": {
              "$ref": "common/definitions#/$defs/outcome"
            },
            "errors": {
              "type": "string"
            },
            "promptTokens": {
              "type": "integer",
              "minimum": 0
            },
            "completionTokens": {
              "type": "integer",
              "minimum": 0
            },
            "totalTokens": {
              "type": "integer",
              "minimum": 0
            },
            "responseModelName": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "modelName",
            "agentRun",
            "outcome"
          ]
        }
      }
    }
  }
}
