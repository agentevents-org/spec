{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-events.dev/0.1.0-draft/schema/guardrail-triggered-event",
  "allOf": [
    {
      "$ref": "common/definitions#/$defs/event"
    }
  ],
  "properties": {
    "context": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "dev.agentevents.guardrail.triggered.0.1.0-draft"
          ],
          "default": "dev.agentevents.guardrail.triggered.0.1.0-draft"
        }
      }
    },
    "subject": {
      "properties": {
        "content": {
          "properties": {
            "guardrailName": {
              "type": "string",
              "minLength": 1
            },
            "agentRun": {
              "$ref": "common/definitions#/$defs/subjectReference"
            },
            "action": {
              "type": "string",
              "enum": [
                "allow",
                "flag",
                "block"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "reason": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "evaluatedSubject": {
              "$ref": "common/definitions#/$defs/evaluatedSubject"
            },
            "stage": {
              "$ref": "common/definitions#/$defs/guardrailStage"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "guardrailName",
            "agentRun",
            "action",
            "evaluatedSubject",
            "stage"
          ],
          "if": {
            "properties": {
              "stage": {
                "const": "tool"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "evaluatedSubject": {
                "properties": {
                  "type": {
                    "const": "toolCall"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
