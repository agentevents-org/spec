            },
            "agentRun": {
              "$ref": "common/definitions#/$defs/subjectReference"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "toolName",
            "agentRun"
