{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-events.dev/0.1.0-draft/schema/custom",
  "allOf": [
    {
      "$ref": "common/definitions#/$defs/event"
    }
  ],
  "properties": {
    "context": {
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^dev\\.agenteventsx\\.[a-zA-Z0-9]+(?:-[a-zA-Z0-9]+)*-[a-zA-Z][a-zA-Z0-9_]*\\.[a-zA-Z][a-zA-Z0-9_]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
        }
      }
    },
    "subject": {
      "properties": {
        "content": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
